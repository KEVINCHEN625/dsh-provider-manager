{
  "name": "dsh-provider-manager",
  "version": "0.2.14",
  "description": "DeepSeek Harness settings page for provider credentials, OpenCode Go / Command Code quota, ZCode / MiMo / MiniMax China-Overseas, per-model 1M context, llm-pi-ai sign-in flows, OpenRouter and other custom APIs, and Muse Code guidance.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KEVINCHEN625/dsh-provider-manager.git"
  },
  "homepage": "https://github.com/KEVINCHEN625/dsh-provider-manager#readme",
  "bugs": {
    "url": "https://github.com/KEVINCHEN625/dsh-provider-manager/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "llm",
    "opencode",
    "provider"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/host/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/host/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./oauth": {
      "types": "./lib/types/host/oauth-entry.d.ts",
      "default": "./lib/oauth.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "compat",
    "scripts/apply-opencode-go-muse-compat.mjs",
    "docs/muse-compat.md",
    "docs/opencode-integrated.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.1.5-rc.2": "compatible"
      }
    }
  },
  "scripts": {
    "build": "tsc --emitDeclarationOnly && tsc -p tsconfig.client.json --emitDeclarationOnly && tsdown",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run --exclude \"tests/*.client.spec.tsx\"",
    "test:client": "vitest run tests/*.client.spec.tsx",
    "check:pack": "pnpm pack --pack-destination artifacts && node scripts/name-content-tarball.mjs && node scripts/check-pack.mjs",
    "check:deploy": "node scripts/check-deploy-consistency.mjs",
    "format:check": "prettier --check src tests scripts",
    "test:muse-compat": "TSX_TSCONFIG_PATH=../deepseek-harness/tsconfig.json node --import ../deepseek-harness/node_modules/tsx/dist/esm/index.mjs --test tests/muse-compat*.node.mjs",
    "check:pack:opencode": "pnpm pack --pack-destination artifacts && node scripts/check-opencode-pack.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2 <5.0.0",
    "@deepseek-ai/dsh-authorization": "*",
    "@deepseek-ai/dsh-client-connection": "*",
    "@deepseek-ai/dsh-client-locale": "*",
    "@deepseek-ai/dsh-client-ui-renderer": "*",
    "@deepseek-ai/dsh-client-ui-settings": "*",
    "@deepseek-ai/dsh-client-ui-slots": "*",
    "@deepseek-ai/dsh-credentials": "*",
    "@deepseek-ai/dsh-host-webserver": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-settings": "*",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-llm-pi-ai": "0.1.5-rc.2",
    "@deepseek-ai/schemastery": ">=3.18.3 <4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-authorization": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.2",
    "@deepseek-ai/dsh-credentials": "0.1.5-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.5-rc.2",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.18.6",
    "@types/react": "18.3.24",
    "@types/react-dom": "18.3.7",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "0.15.12",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "@deepseek-ai/dsh-llm-pi-ai": "0.1.5-rc.2",
    "@deepseek-ai/schemastery": "3.18.3"
  },
  "engines": {
    "node": ">=22.19"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.85.1"
  }
}
